.githooks/* text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
src/legal/* text eol=lf
# Tauri rewrites this manifest using LF during production builds.
src-tauri/Cargo.toml text eol=lf
# Vendored upstream code retains its actual provenance.
vendor/** linguist-vendored
# The upstream permission generator writes LF and embeds the default description.
# Keep these inputs and tracked outputs stable on Windows autocrlf checkouts.
vendor/tauri-plugin-updater/permissions/default.toml text eol=lf
vendor/tauri-plugin-updater/permissions/autogenerated/commands/check.toml text eol=lf
vendor/tauri-plugin-updater/permissions/autogenerated/commands/download.toml text eol=lf
vendor/tauri-plugin-updater/permissions/autogenerated/commands/download_and_install.toml text eol=lf
vendor/tauri-plugin-updater/permissions/autogenerated/commands/install.toml text eol=lf
vendor/tauri-plugin-updater/permissions/autogenerated/reference.md text eol=lf
vendor/tauri-plugin-updater/permissions/schemas/schema.json text eol=lf
scripts/packaging/build.ps1 -linguist-detectable
scripts/packaging/package.py -linguist-detectable
scripts/packaging/test_package.py -linguist-detectable
tools/prepare_installer_toolchain.py -linguist-detectable
tools/build_installer_utils.py -linguist-detectable
