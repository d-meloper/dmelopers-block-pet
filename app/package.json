{
  "name": "dmelopers-block-pet",
  "type": "module",
  "version": "1.1.1",
  "private": true,
  "author": "DMeloper",
  "license": "MIT",
  "scripts": {
    "dev": "run-s dev:icon dev:broadcast dev:vite",
    "dev:icon": "tsx scripts/buildIcon.ts --cached",
    "dev:broadcast": "tsx scripts/buildBroadcast.ts --cached",
    "build": "run-s build:*",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build:icon": "tsx scripts/buildIcon.ts",
    "build:broadcast": "tsx scripts/buildBroadcast.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint --fix src",
    "preinstall": "node -e \"if (!process.env.npm_config_user_agent?.startsWith('pnpm/')) { console.error('Use pnpm to install dependencies.'); process.exit(1) }\""
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-store/pinia": "^3.7.1",
    "@vueuse/core": "^13.9.0",
    "ant-design-vue": "^4.2.6",
    "es-toolkit": "^1.45.1",
    "is-url": "^1.2.4",
    "pinia": "^3.0.4",
    "tauri-plugin-locale-api": "^2.0.1",
    "three": "0.185.1",
    "vue": "^3.5.42",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@iconify-json/lucide": "^1.2.102",
    "@iconify-json/solar": "^1.2.5",
    "@tauri-apps/cli": "^2.11.4",
    "@types/is-url": "^1.2.32",
    "@types/node": "^22.19.17",
    "@types/three": "0.185.1",
    "@unocss/eslint-plugin": "^66.6.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^1.5.0",
    "lint-staged": "^16.4.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.99.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unocss": "^66.6.8",
    "vite": "^6.4.3"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": "eslint --fix",
    "scripts/**/*.ts": "eslint --fix"
  }
}
