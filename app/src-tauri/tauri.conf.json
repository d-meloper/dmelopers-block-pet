{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DMeloper's Block Pet",
  "version": "../package.json",
  "identifier": "com.dmeloper.blockpet",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DMeloper's Block Pet",
        "url": "index.html/#/",
        "shadow": false,
        "alwaysOnTop": true,
        "transparent": true,
        "decorations": false,
        "acceptFirstMouse": true,
        "width": 500,
        "height": 422,
        "visible": false,
        "resizable": false,
        "skipTaskbar": true,
        "maximizable": false
      },
      {
        "label": "preference",
        "url": "index.html/#/preference",
        "visible": false,
        "width": 911,
        "height": 692,
        "minWidth": 669,
        "minHeight": 458,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob: asset: http://asset.localhost; connect-src 'self' data: ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost; worker-src 'self' blob:; font-src 'self' data:; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": false,
    "category": "Entertainment",
    "targets": [],
    "shortDescription": "DMeloper's Block Pet",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "assets/tray.png",
      "assets/models/dmeloper/dmeloper.glb",
      "assets/models/dmeloper/default.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "minimumWebview2Version": "120.0.0.0"
    }
  }
}
